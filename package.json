{
	"name": "ya-invisible-captcha-client",
	"version": "1.2.3",
	"description": "Лёгкий клиент для невидимой Яндекс.Каптчи с поддержкой форм и модальных окон. Поддерживает auto-init через data-атрибуты и гибкое встроение в DOM.",
	"keywords": [
		"yandex",
		"captcha",
		"invisible",
		"ya-captcha",
		"form-validation",
		"security",
		"frontend",
		"typescript"
	],
	"author": "Poliklot",
	"license": "MIT",
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"import": "./index.js",
			"require": "./index.cjs",
			"types": "./index.d.ts"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"release": "node scripts/release.js",
		"test": "jest --coverage",
		"lint": "eslint src --ext .ts",
		"versions:sync": "node scripts/sync-version.js",
		"demos": "BUILD_TARGET=demos npm run build && concurrently --kill-others \"vite\" \"npm run watch\"",
		"prepare:package": "node scripts/prepare-package.mjs",
		"pack:check": "npm run build && npm run prepare:package && npm pack --dry-run ./package",
		"check": "npm test -- --runInBand && npm run pack:check"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Poliklot/ya-invisible-captcha-client"
	},
	"bugs": {
		"url": "https://github.com/Poliklot/ya-invisible-captcha-client/issues"
	},
	"homepage": "https://github.com/Poliklot/ya-invisible-captcha-client#readme",
	"publishConfig": {
		"access": "public"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@babel/preset-env": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-babel": "^7.1.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/jest": "^30.0.0",
		"@types/jsdom": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"chalk": "^6.0.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"form-father": "^0.8.15",
		"fs-extra": "^11.4.0",
		"globals": "^17.12.0",
		"inquirer": "^14.2.2",
		"jest": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"ora": "^9.4.1",
		"postcss-preset-env": "^11.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-jsdoc": "^1.8.1",
		"rollup": "^4.63.1",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-dts": "^6.5.1",
		"sass-embedded": "^1.104.0",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"overrides": {
		"minimatch": "10.2.6",
		"test-exclude": "8.0.0"
	}
}
